# Keep this source backup an allowlist. Local document data and runtimes stay local.
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/HANDOFF.md
!/TESTING-TODO.md
!/README.md
!/LICENSE
!/NOTICE
!/THIRD-PARTY-NOTICES.md
!/third-party/
/third-party/*
!/third-party/licenses/
/third-party/licenses/*
!/third-party/licenses/*.txt
!/third-party/licenses/README.md
!/START-HERE.md
!/pyproject.toml
!/remediator.example.toml
!/launch_review.pyw
!/Setup PDF Remediator.cmd
!/Start PDF Remediator.cmd
!/src/
!/src/**
!/tests/
/tests/*
!/tests/test_*.py
!/tests/browser_page.py
!/eval/
/eval/*
!/eval/*.py
!/eval/*.md
!/eval/external/
/eval/external/*
!/eval/external/PROVENANCE.md
!/eval/evidence/
/eval/evidence/*
!/eval/evidence/eval-requirements.lock.txt
!/eval/evidence/odl-requirements.lock.txt
!/eval/evidence/ocr-requirements.lock.txt
!/eval/evidence/accesspdf-requirements.lock.txt
!/docs/
/docs/*
!/docs/*.md
!/scripts/
/scripts/*
!/scripts/*.py
!/scripts/*.sh
!/scripts/test-web-assets.cjs
!/scripts/test-plain-evidence.cjs
!/scripts/e2e-browser.cjs
!/scripts/windows-installer.cs
!/scripts/windows-launcher.cs
!/scripts/windows-vc-runtime.cs
!/scripts/windows-runtime-lock.json
!/scripts/windows-ocr-runtime-lock.json
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/*.yml
!/.github/workflows/*.yaml

# Never track document inputs, generated outputs, credentials, or model/runtime data.
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.venv/
**/.venvs/
**/.env
**/.env.*
**/*credentials*
**/*secret*
**/*session*.json
**/*.log
**/*.pdf
**/*.PDF
**/*.docx
**/*.png
**/*.jpg
**/*.jpeg
**/*.zip
**/*.whl
**/*.exe
**/*.dll
**/*.jar
**/*.gguf
**/*.safetensors
**/*.pem
**/*.key
**/*.pfx
**/id_rsa*
**/id_ed25519*

# Public Content Credentials code and synthetic tests; private credential data stays ignored.
!/src/pdf_remediator/credentials.py
!/tests/test_credentials.py
!/tests/test_credentials_additional.py
!/tests/test_credentials_web.py
!/tests/test_credentials_workspace.py
